# Auto scheduled version upgrade

/system script {
  remove [ find name=auto-upgrade ]
  add name=auto-upgrade source=\
    "/system package update; \
    set channel=long-term; \
    check-for-updates once; \
    :delay 3s; \
    :if ([ get status ] = \"New version is available\") do={ install }"
}

/system scheduler {
  remove [ find name=scheduled-system-upgrade ]
  add name=scheduled-system-upgrade start-time=06:00:00 interval=1d \
    policy=reboot,read,write,policy on-event=auto-upgrade
}
